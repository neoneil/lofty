      "icon": "moon",
      "rarity": "rare",
      "hidden": true,
      "condition": { "type": "practice_time_window", "from": "00:00", "to": "04:00" }
    },
    {
      "id": "ielts_reading_listening_started",
      "title": "双核心启动",
      "englishTitle": "Core Skills Started",
      "description": "Reading 与 Listening 都至少完成 1 道题。",
      "icon": "layout-grid",
      "rarity": "uncommon",
      "hidden": true,
      "condition": { "type": "all_modules_completed_at_least", "gte": 1 }
    }
  ],
  "typeLevelRule": {
    "description": "For IELTS questionTypes.levels array. Use completed count and accuracy to map a user to one of five academic titles.",
    "levels": [
      { "index": 0, "condition": { "completed": { "gte": 1 } } },
      { "index": 1, "condition": { "completed": { "gte": 20 } } },
      { "index": 2, "condition": { "completed": { "gte": 60 } } },
      { "index": 3, "condition": { "completed": { "gte": 120 }, "accuracy": { "gte": 0.8 } } },
      { "index": 4, "condition": { "completed": { "gte": 240 }, "accuracy": { "gte": 0.9 } } }
    ]
  },
  "rarityLabels": {
    "common": "基础",
    "uncommon": "进阶",
    "rare": "高分",
    "epic": "卓越",
    "legendary": "九分",
    "mythic": "旗舰"
  }
