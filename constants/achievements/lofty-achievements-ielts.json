      "icon": "mic",
      "colorToken": "achievement.ielts.speaking",
      "levels": [
        { "level": 1, "title": "开口试讲", "englishTitle": "First Response", "condition": { "type": "module_completed_questions", "module": "speaking", "gte": 5 } },
