      "icon": "compass",
      "colorToken": "achievement.ielts.overall",
      "levels": [
        {
          "level": 1,
          "title": "剑桥启航",
          "englishTitle": "Cambridge Starter",
          "subtitle": "完成第一道 IELTS 练习，正式开启九分路线。",
          "condition": { "type": "total_completed_questions", "gte": 1 }
        },
        {
          "level": 2,
          "title": "航线稳定",
          "englishTitle": "Steady Navigator",
          "subtitle": "累计完成 80 道 IELTS 练习，学习节奏已经成形。",
          "condition": { "type": "total_completed_questions", "gte": 80 }
        },
        {
          "level": 3,
          "title": "高分领航员",
          "englishTitle": "High-Band Navigator",
          "subtitle": "累计完成 240 道 IELTS 练习，对剑桥题型更熟悉。",
          "condition": { "type": "total_completed_questions", "gte": 240 }
        },
        {
          "level": 4,
          "title": "九分候选人",
          "englishTitle": "Band 9 Candidate",
          "subtitle": "综合正确率达到 85%，且至少完成 400 道练习。",
          "condition": { "type": "overall_accuracy", "gte": 0.85, "minCompletedQuestions": 400 }
        }
      ]
    },
    {
      "id": "speaking",
      "name": "口语面试厅",
