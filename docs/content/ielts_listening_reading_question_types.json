          "typical_parts": [
            2,
            3
          ],
          "difficulty": "medium_to_hard",
          "strategies": [
            "先明确匹配主体是什么：人、地点、特征、意见还是结果。",
            "快速为选项写下简短关键词。",
            "注意选项可能重复使用，也可能有多余选项，以题目说明为准。",
            "多人对话中要区分是谁表达了某个观点。"
          ],
          "common_traps": [
            "混淆不同说话人的意见。",
            "录音先提出一个方案，后又改成另一个方案。",
            "只根据单个词匹配，忽略整体含义。"
          ],
          "frontend": {
            "recommended_component": "QuestionTypeDetailCard",
            "badge": "匹配题",
            "search_keywords": [
