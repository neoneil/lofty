          "name_cn": "多选题",
          "name_en": "Multiple Choice — Multiple Answers",
          "short_name": "MCQ Multiple",
          "answer_format": "从较长选项列表中选择指定数量的答案",
          "description_cn": "按照题目要求选择两个或更多正确选项。",
          "skills_tested": [
            "筛选信息",
            "归纳多个要点",
            "识别态度与原因"
          ],
          "typical_parts": [
            2,
            3,
            4
          ],
          "difficulty": "hard",
          "strategies": [
            "先确认必须选择几个答案。",
            "预读全部选项并归类，例如优点、问题、原因或建议。",
            "听到一个候选答案时先做标记，等上下文完整后再确认。",
            "多选题答案出现顺序未必与选项字母顺序一致。"
          ],
          "common_traps": [
            "选择数量错误。",
