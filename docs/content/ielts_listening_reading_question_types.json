      "global_strategies": [
        "播放前快速阅读题目，圈出关键词并预测答案词性。",
        "注意题目中的字数限制，例如 NO MORE THAN TWO WORDS AND/OR A NUMBER。",
        "答案通常按录音顺序出现；漏掉一题后应立即跟进下一题。",
        "重点识别同义替换，而不是等待录音原词重复题干。",
        "警惕说话人自我纠正、否定、转折和最终决定。",
        "检查单复数、拼写、数字、日期、时间和单位。",
        "选择题先比较选项差异，再带着差异听录音。",
        "填空题根据空格前后语法预测名词、动词、形容词或数字。"
      ],
      "question_types": [
        {
          "id": "listening_multiple_choice_single",
          "official_family": "multiple_choice",
          "name_cn": "单选题",
          "name_en": "Multiple Choice — Single Answer",
          "short_name": "MCQ Single",
          "answer_format": "选择一个字母",
          "description_cn": "从通常三个选项中选择一个正确答案，或为句子选择一个正确结尾。",
          "skills_tested": [
            "理解主旨",
            "识别具体信息",
            "理解说话人态度",
            "区分相似信息"
          ],
          "typical_parts": [
            2,
            3,
            4
          ],
          "difficulty": "medium_to_hard",
          "strategies": [
            "先读题干，再比较选项之间真正不同的词。",
            "把每个选项压缩为一个核心意思，避免边听边读长句。",
            "录音可能依次提到所有选项，但只有最终态度或结论正确。",
            "重点听 but、however、actually、instead、eventually 等转折或修正信号。"
          ],
          "common_traps": [
            "录音提到某选项但随后否定或修改。",
            "选项使用录音原词，但意思不符合题目。",
            "考生听到熟悉词后过早作答。"
          ],
          "frontend": {
            "recommended_component": "QuestionTypeDetailCard",
            "badge": "选择题",
            "search_keywords": [
              "单选",
              "multiple choice",
              "MCQ"
            ]
          }
        },
        {
          "id": "listening_multiple_choice_multiple",
